# Copy to docker/.env and fill in. The app and its results viewer (port 15500) both ask for this login.
TRIALS_AUTH_USER=
TRIALS_AUTH_PASSWORD=
# A LiteLLM virtual key limited to the models listed in your models.yaml, with a budget cap.
LITELLM_API_KEY=
# Where the Recordings page imports runs from. The proxy's S3 request logs are complete; its spend log can miss requests.
# Credentials that may list the bucket and read its objects (or leave them out and mount a profile instead).
S3_LOGS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
